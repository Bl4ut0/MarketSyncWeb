{
  "name": "marketsync-web",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source multi-era World of Warcraft Auction House web browser and shopping list companion for MarketSync",
  "license": "GPL-3.0-only",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "build": "tsc -b shared server",
    "build:harbor": "vite build harbor --outDir ../dist/harbor --emptyOutDir && node -e \"require('node:fs').copyFileSync('harbor/.htaccess', 'dist/harbor/.htaccess')\"",
    "typecheck": "tsc --noEmit -p shared/tsconfig.json && tsc --noEmit -p shared/tsconfig.test.json && tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p server/tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "start:server": "node server/dist/server.node.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.20",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.4",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^4.1.12",
    "wrangler": "^4.166.0"
  }
}
